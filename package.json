{
  "name": "grant",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:check": "node --env-file-if-exists=.env.local scripts/check-db.mjs",
    "db:check:test": "node --env-file-if-exists=.env.local scripts/check-db.mjs --test",
    "g0:setup": "node --env-file-if-exists=.env.local scripts/g0-setup.mjs",
    "buyer:ceiling": "node --env-file-if-exists=.env.local scripts/fund-buyer-ceiling.mjs",
    "g0:seller": "node --env-file-if-exists=.env.local scripts/g0-seller.mjs",
    "g0:buyer": "node --env-file-if-exists=.env.local scripts/g0-buyer.mjs",
    "x402:vercel:buyer": "node --env-file-if-exists=.env.local scripts/x402-vercel-buyer.mjs",
    "r2:check": "node --env-file-if-exists=.env.local scripts/check-r2.mjs",
    "seller:create": "node --env-file-if-exists=.env.local scripts/create-seller-account.mjs",
    "catalog:ingest": "node --env-file-if-exists=.env.local --import tsx scripts/ingest-catalog.ts",
    "demo:reset": "node --env-file-if-exists=.env.local scripts/demo-reset.mjs",
    "db:generate": "node --env-file-if-exists=.env.local ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:migrate:test": "node --env-file-if-exists=.env.local scripts/migrate.mjs --test",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "db:seed:test": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts --test",
    "db:seed:testnet": "node --env-file-if-exists=.env.local --import tsx scripts/seed-testnet-offer.ts",
    "r2:proof:setup": "node --env-file-if-exists=.env.local --import tsx scripts/r2-proof-setup.ts",
    "r2:proof:check": "node --env-file-if-exists=.env.local scripts/r2-proof-check.mjs",
    "payment:proof": "node --env-file-if-exists=.env.local --import tsx scripts/approved-payment-proof.ts",
    "payment:proof:production": "node --env-file-if-exists=.env.local scripts/production-payment-proof.mjs",
    "pdf:proof": "node --env-file-if-exists=.env.local scripts/pdf-delivery-proof.mjs",
    "audio:proof": "node --env-file-if-exists=.env.local scripts/audio-delivery-proof.mjs",
    "share:proof": "node --env-file-if-exists=.env.local scripts/share-proof.mjs",
    "test": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs",
    "test:db": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run tests/persistence.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1170.0",
    "@aws-sdk/s3-request-presigner": "3.1170.0",
    "@neondatabase/serverless": "1.2.1",
    "@stellar/stellar-sdk": "17.4.0",
    "@x402/core": "2.30.0",
    "@x402/express": "2.30.0",
    "@x402/fetch": "2.30.0",
